# Copy to .env locally. Never commit the populated file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
# Copy the Session pooler URI from Supabase > Connect.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Local hackathon role buttons only; keep disabled in deployments.
ENABLE_LOCAL_DEMO_LOGIN=False
